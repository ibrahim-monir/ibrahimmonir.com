# Public API base used by the production build. Laravel now lives on the
# same account/domain as the frontend (backend/app/ -- see public_html.htaccess),
# not on a separate api.* subdomain.
# NEXT_PUBLIC_* vars are inlined at build time, so this must be present when `next build` runs.
NEXT_PUBLIC_API_URL=https://ibrahimmonir.com/api
