<IfModule mod_rewrite.c>
    RewriteEngine On

    # Canonicalize to the apex domain (matches metadataBase in layout.tsx).
    # Used to be next.config.ts's redirects() -- static export has no server
    # to run that on, so it moves here.
    RewriteCond %{HTTP_HOST} ^www\.ibrahimmonir\.com$ [NC]
    RewriteRule ^(.*)$ https://ibrahimmonir.com/$1 [R=301,L]

    # The Packages page was renamed to Pricing.
    RewriteRule ^packages/?$ /pricing [R=301,L]

    # Laravel now lives alongside the static frontend on the same account
    # (see app/ -- no api.ibrahimmonir.com subdomain anymore). Public storage
    # files are served straight off disk; everything else Laravel owns goes
    # through its front controller with REQUEST_URI left untouched, so
    # Laravel's own /api, /admin, /up, /sanctum routes still match as-is.
    RewriteRule ^storage/(.*)$ /app/storage/$1 [L]
    RewriteRule ^(api|admin|up|sanctum)(/.*)?$ /app/index.php [L]

    # Next's static export writes clean URLs as "route.html" files (e.g.
    # blog/test-post.html for /blog/test-post), not route/index.html -- map
    # extension-less requests to the matching .html file.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^(.*)$ $1.html [L]
</IfModule>

ErrorDocument 404 /404.html
