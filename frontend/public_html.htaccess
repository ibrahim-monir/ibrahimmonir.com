<IfModule mod_rewrite.c>
    RewriteEngine On

    # Canonicalize to the apex domain (matches metadataBase in layout.tsx).
    # Used to be next.config.ts's redirects() -- static export has no server
    # to run that on, so it moves here.
    RewriteCond %{HTTP_HOST} ^www\.ibrahimmonir\.com$ [NC]
    RewriteRule ^(.*)$ https://ibrahimmonir.com/$1 [R=301,L]

    # The Packages page was renamed to Pricing.
    RewriteRule ^packages/?$ /pricing [R=301,L]

    # Laravel now lives alongside the static frontend on the same account
    # (see app/ -- no api.ibrahimmonir.com subdomain anymore). Public storage
    # files are served straight off disk; everything else Laravel owns goes
    # through its front controller with REQUEST_URI left untouched, so
    # Laravel's own /api, /admin, /up, /sanctum routes still match as-is.
    # Livewire also registers a JS/update endpoint at a fixed-format
    # /livewire-{8 hex chars} prefix (hashed from APP_KEY, see
    # EndpointResolver::prefix()) that isn't under any of those -- without
    # this, Livewire's own script tag 404s and every Filament admin page
    # loads with no interactivity.
    RewriteRule ^storage/(.*)$ /app/storage/$1 [L]
    RewriteRule ^(api|admin|up|sanctum)(/.*)?$ /app/index.php [L]
    RewriteRule ^livewire-[0-9a-f]{8}(/.*)?$ /app/index.php [L]

    # Next's static export writes clean URLs as "route.html" files (e.g.
    # blog/test-post.html for /blog/test-post), not route/index.html -- map
    # extension-less requests to the matching .html file.
    #
    # Next 16 ALSO writes a same-named directory for every route (blog/,
    # works/, ... holding the __next.*.txt segment payloads), so these rules
    # must NOT skip directories (the old `!-d` condition did, and Apache fell
    # through to an "Index of /blog/" listing on every reload/direct visit).

    # /blog/ -> /blog when blog.html exists (one canonical URL per page).
    # (%{DOCUMENT_ROOT}, not %{REQUEST_FILENAME}: LiteSpeed strips the
    # trailing slash from REQUEST_FILENAME, so a regex on it never matched.)
    RewriteCond %{DOCUMENT_ROOT}/$1.html -f
    RewriteRule ^(.+)/$ /$1 [R=301,L]

    # /blog -> blog.html, even though a blog/ directory also exists.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^(.+)$ $1.html [L]
</IfModule>

# Never list directory contents (/_next/, route folders, uploads, ...).
Options -Indexes

# Stop mod_dir from 301-ing /blog to /blog/ just because a blog/ folder
# exists -- the rewrite above serves blog.html for /blog instead.
<IfModule mod_dir.c>
    DirectorySlash Off
</IfModule>

ErrorDocument 404 /404.html
